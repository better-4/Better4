  { Trigger = { TripleInOrder , down , up , Triangle , 1000 } TrickSlot = SpLip_D_U_Triangle }
  { Trigger = { TripleInOrder , down , Right , Triangle , 1000 } TrickSlot = SpLip_D_R_Triangle }
